DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
POLL_INTERVAL_SECONDS=300
TIME_ZONE=America/New_York
SECONDARY_TEAM=
# Optional for non-Docker runs; Docker uses compose.x-browser.yaml.
X_FEED_FILE=
# Host public-feed directory for compose.x-browser.yaml (defaults to ./.x-feed).
X_FEED_DIRECTORY=
# For an X-enabled deployment, persist BOTH Compose files so unattended updates
# also retain X. Windows uses ";" here; Linux/macOS use ":" instead.
# COMPOSE_FILE=compose.yaml;compose.x-browser.yaml
